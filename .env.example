# ============================================================
# HALODEPOK CONTENT FACTORY — Environment Variables
# ============================================================

# --- REQUIRED ---
# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# NextAuth / Auth
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# --- OPTIONAL ---
# Google Custom Search (for source discovery)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# SerpAPI
SERP_API_KEY=

# News API
NEWS_API_KEY=

# WordPress (if publishing to WordPress)
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=

# Upstash Redis (for rate limiting / caching)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- DEVELOPMENT ONLY ---
# Set to "development" or "production"
NODE_ENV=development

# Override AI provider endpoint (for local proxies)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Mock providers (set to "true" to use mocks instead of real APIs)
USE_MOCK_AI=false
USE_MOCK_SEARCH=false
USE_MOCK_PUBLISHER=false
USE_MOCK_AFFILIATE=false
USE_MOCK_TTS=false

# --- PRODUCTION ONLY ---
# Database URL (for migrations)
DATABASE_URL=postgresql://user:pass@host:5432/halodepok

# Redis URL
REDIS_URL=redis://localhost:6379

# AI Budget limits (USD per month)
MONTHLY_AI_BUDGET=500

# --- RATE LIMITING ---
# Upstash rate limit (requests per minute)
RATE_LIMIT_REQUESTS=60

# Affiliate
AFFILIATE_NETWORK_API_KEY=

# AWS S3 / Cloudflare R2 (for media storage)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
